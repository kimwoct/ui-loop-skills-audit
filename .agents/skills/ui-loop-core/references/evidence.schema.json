{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI loop evidence",
  "type": "object",
  "required": ["round", "loop", "tier", "state", "reference", "walkthrough", "dispatch", "pr", "issues"],
  "properties": {
    "round": {"type": "string", "minLength": 1},
    "loop": {"enum": ["fix", "logic", "verify"]},
    "tier": {"enum": ["T0", "T1", "T2"]},
    "state": {"enum": ["DRAFT", "REVIEW", "PREVIEW", "APPROVED", "IMPLEMENTED", "DEPLOYED", "VERIFIED", "BLOCKED"]},
    "reference": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["artifact", "canvas", "environment"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "walkthrough": {
      "type": "object",
      "required": ["steps", "script", "driver", "profileOrAccount", "role"],
      "properties": {
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "script": {"type": "string", "minLength": 1},
        "driver": {"enum": ["ego-browser", "playwright"]},
        "profileOrAccount": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "dispatch": {
      "type": "object",
      "required": ["agent", "runId", "herdrSession"],
      "properties": {
        "agent": {"type": "string"},
        "runId": {"type": "string"},
        "herdrSession": {"type": "string"}
      }
    },
    "pr": {
      "type": "object",
      "required": ["url", "base", "head", "mergeSha"],
      "properties": {
        "url": {"type": "string"},
        "base": {"type": "string"},
        "head": {"type": "string"},
        "mergeSha": {"$ref": "#/$defs/pendingText"}
      }
    },
    "issues": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expected", "local", "deployed"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "expected": {"type": "string"},
          "local": {"$ref": "#/$defs/evidence"},
          "deployed": {
            "allOf": [
              {"$ref": "#/$defs/evidence"},
              {"required": ["env"], "properties": {"env": {"$ref": "#/$defs/pendingText"}}}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "pendingText": {"type": ["string", "null"], "minLength": 1},
    "evidence": {
      "type": "object",
      "required": ["result", "buildSha", "artifact"],
      "properties": {
        "result": {"enum": ["pass", "fail", null]},
        "buildSha": {"$ref": "#/$defs/pendingText"},
        "artifact": {"$ref": "#/$defs/pendingText"}
      }
    }
  }
}
